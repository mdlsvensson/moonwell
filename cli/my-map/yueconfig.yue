-- Read by VS Code's YueScript extension (LiJin.yuescript). Moonwell builds from src/ on its own; these settings only
-- drive the editor. See "Editor setup" in Moonwell's README.
return
  -- Write src/**/*.lua when a .yue file is saved, keeping its line numbers and comments: the extension needs all
  -- three for lua-language-server. The .lua files are git-ignored and never used by builds.
  build: true
  reserve_line_number: true
  reserve_comment: true
  -- Unknown globals are reported by lua-language-server, from .moonwell/types, and by `deno task check`.
  lint_global: false
  -- Where `import "moonwell.macros"` is found; Moonwell writes that folder.
  include:
    - ".moonwell/yue"
  options:
    target: "5.3"
