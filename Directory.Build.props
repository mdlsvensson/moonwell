<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The projects under src/ that end up inside a map (the native layer, the generated standard objects, the runtime)
    are compiled to Lua by CSharp.lua, whose Roslyn reads C# 13. They take no implicit usings, so every name they use
    is one the map's Lua must carry.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Moonwell' Or '$(MSBuildProjectName)' == 'Moonwell.Natives' Or '$(MSBuildProjectName)' == 'Moonwell.Objects'">
    <LangVersion>13</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Moonwell' And '$(MSBuildProjectName)' != 'Moonwell.Natives' And '$(MSBuildProjectName)' != 'Moonwell.Objects'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
