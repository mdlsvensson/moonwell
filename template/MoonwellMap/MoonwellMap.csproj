<Project Sdk="Microsoft.NET.Sdk">

  <!-- The map's script is compiled to Lua by CSharp.lua, which reads C# 13. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moonwell.Objects" Version="MOONWELL_VERSION" />
    <!-- For damage reactions in stages (before and after armor, lethal, landed), take the comment off the next line. -->
    <!-- <PackageReference Include="Moonwell.Damage" Version="MOONWELL_VERSION" /> -->
    <!-- For vectors, angles, easing, polygons and raycasts, take the comment off the next line. -->
    <!-- <PackageReference Include="Moonwell.Maths" Version="MOONWELL_VERSION" /> -->
  </ItemGroup>

</Project>
