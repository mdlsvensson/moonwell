<Project Sdk="Microsoft.NET.Sdk">

  <!-- The map's script is compiled to Lua by CSharp.lua, which reads C# 13. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moonwell.Objects" Version="MOONWELL_VERSION" />
  </ItemGroup>

</Project>
