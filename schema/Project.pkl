/// Root schema for a Moonwell project's `moonwell.pkl`.
///
/// Every property has a default, so a manifest only needs what it changes. The template's `moonwell.pkl` spells out the
/// everyday settings; the advanced ones (the whole `yue` block and the raw `settings.gameplayConstants` and
/// `settings.gameInterface` mappings) are left out and keep their defaults unless set.
/// Machine-specific values belong in `moonwell.local.pkl`, which amends `moonwell.pkl` and is git-ignored.
module moonwell.Project

import "MapSettings.pkl"
import "Objects.pkl"

/// `path` split on `/` and `\`, without empty and `.` segments.
local const function segments(path: String): List<String> =
  path.replaceAll("\\", "/").split("/").filter((segment) -> segment != "" && segment != ".")

/// A non-empty relative path: no leading `/` or `\`, no drive letter and no `..` segment.
local const function isRelativeFolder(path: String): Boolean =
  !segments(path).isEmpty
    && !path.startsWith("/")
    && !path.startsWith("\\")
    && !path.matches(Regex(#"[A-Za-z]:.*"#))
    && !segments(path).contains("..")

/// Whether `path` is, or is under, a folder Moonwell reads from or stages into.
local const function isReservedFolder(path: String): Boolean =
  let (parts = segments(path).map((segment) -> segment.toLowerCase()))
    parts.firstOrNull == "maps"
      || parts.firstOrNull == "src"
      || (parts.length >= 2 && parts[0] == "dist" && parts[1] == "stage")

/// Lua 5.3's reserved words, which cannot name a global.
local const luaKeywords = Set(
  "and", "break", "do", "else", "elseif", "end", "false", "for", "function", "goto", "if", "in", "local", "nil", "not",
  "or", "repeat", "return", "then", "true", "until", "while"
)

/// A Lua name: letters, digits and `_`, not starting with a digit, and not a reserved word.
local const function isLuaName(name: String): Boolean =
  name.matches(Regex(#"[A-Za-z_][A-Za-z0-9_]*"#)) && !luaKeywords.contains(name)

class MapConfig {
  /// Folder under `maps/` holding the World Editor source map (folder format, Lua script mode).
  folder: String(endsWith(".w3x"), isRelativeFolder(this)) = "map.w3x"

  /// Gameplay entry file, relative to the project root.
  entry: String(startsWith("src/"), endsWith(".yue")) = "src/main.yue"
}

class BuildConfig {
  /// Folder, relative to the project root, that receives the packed `.w3x`.
  /// It cannot contain `..`, and cannot be or be under `maps`, `src` or `dist/stage`.
  folder: String(isRelativeFolder(this), !isReservedFolder(this)) = "dist/bin"

  /// Minify compiled Lua. Runtime errors then name the `.yue` file without a line number.
  minify: Boolean = false
}

class LaunchConfig {
  /// Path to `Warcraft III.exe`. Set this in `moonwell.local.pkl`.
  gameExecutable: String?

  /// Arguments passed before `-loadfile <map>`. Assigning a list replaces the default one:
  /// `args = List("-launch", "-windowmode", "fullscreen")`.
  args: List<String> = List("-launch", "-windowmode", "windowed")
}

/// Advanced: the YueScript compiler. Most projects never set this block.
class YueConfig {
  /// YueScript compiler version. Moonwell downloads it and verifies it against a checksum pinned in the CLI, so only
  /// versions that CLI release knows are accepted. Leave unset to use the version pinned by this schema release.
  version: String(matches(Regex(#"\d+\.\d+\.\d+"#))) = "0.34.3"

  /// Path to a `yue` binary to use instead of downloading one, for example a compiler you built yourself.
  /// Set it in `moonwell.local.pkl`, since the path is specific to your machine.
  path: String?
}

class AssetsConfig {
  /// Files under `assets/` keep their relative path in the map. Map one here to import it at an exact in-map path,
  /// such as `["icons/BTNSword.blp"] = #"ReplaceableTextures\CommandButtons\BTNSword.blp"#`.
  paths: Mapping<String(!isEmpty), String(!isEmpty)> = new {}

  /// Files under `assets/`, or folders ending in `/`, that are not imported. Names starting with `.` never are.
  exclude: List<String(!isEmpty)> = List()
}

class LintConfig {
  /// What `check`, `build`, `test` and `dev` do with a global that nothing defines. Known globals are the game's
  /// natives, Blizzard.j functions and globals, the Lua libraries the game provides, the globals and functions of the
  /// source map's `war3map.lua`, `globals` below, and the names declared with `global` or defined at the top level of
  /// a Lua file in the modules the map requires (its entry and every module reached through `import` or `require`).
  /// Only the `src/` modules the map requires are checked. `"error"` fails the command; `"warning"` reports each one
  /// and continues.
  unknownGlobals: "error"|"warning" = "error"

  /// Extra global names to allow, such as those a `global *` or `global ^` file creates: Moonwell does not detect
  /// those.
  globals: List<String(isLuaName(this))> = List()
}

/// A library of YueScript and Lua modules, and of the files it ships for the map: a GitHub tag, or a local folder
/// (specs: Lua modules and libraries; library assets). A library may describe its layout in a moonwell-library.json
/// at its root: `dir`, the folder its module names start from, and `assets`, the folder whose files the map imports.
class Library {
  /// A GitHub repository, "owner/repo". With `tag`, Moonwell downloads that tag; moonwell.lock records its commit.
  github: String(matches(Regex(#"[A-Za-z0-9-]+/[A-Za-z0-9._-]+"#)))?

  /// The tag to download.
  tag: String(!isEmpty)?

  /// A local folder instead, the library's root, relative to the project or absolute. When set, `github` and `tag` are
  /// ignored: set it in moonwell.local.pkl to work on a library next to the map.
  path: String(!isEmpty)?

  /// The folder inside the library that module names start from, such as "src". Leave it empty for a library that
  /// names its own in moonwell-library.json; without that file, empty is the library's root.
  dir: String(isEmpty || isRelativeFolder(this)) = ""
}

map: MapConfig = new {}
build: BuildConfig = new {}
launch: LaunchConfig = new {}
yue: YueConfig = new {}
assets: AssetsConfig = new {}
lint: LintConfig = new {}

/// Libraries of modules, named by their path in the library (`import "example.loud"`). The key names the library's
/// folder in .moonwell/libraries/.
libraries: Mapping<String(matches(Regex(#"[A-Za-z0-9_-]+"#))), Library> = new {}

settings: MapSettings = new {}

/// Custom units, heroes, buildings, items, abilities, buffs and upgrades, written into the built map. Wire in the files
/// under `objects/` with `import "@moonwell/Objects.pkl"` and `objects = Objects.merge(import*("objects/**.pkl"))`.
objects: Objects = new {}
