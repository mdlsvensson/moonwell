amends "pkl:test"

import "pkl:json"
import "pkl:test" as t
import "../Project.pkl"
import "fixtures/project.pkl" as fixture

/// The fixture rendered through its module output, as `pkl eval -f json` does.
local fixtureJson = (fixture.output) { renderer = new JsonRenderer {} }.text
local parsed = new json.Parser {}.parse(fixtureJson) as Dynamic

facts {
  ["defaults"] {
    Project.map.folder == "map.w3x"
    Project.map.entry == "src/main.yue"
    Project.build.folder == "dist/bin"
    Project.build.minify == false
    Project.launch.gameExecutable == null
    Project.launch.args == List("-launch", "-windowmode", "windowed")
    Project.yue.version == "0.34.2"
    Project.yue.path == null
    Project.assets.paths.isEmpty
    Project.assets.exclude == List()
  }
  ["overrides are accepted"] {
    (Project) { map { folder = "hero.w3x"; entry = "src/game/init.yue" } }.map.entry == "src/game/init.yue"
  }
  ["launch args replace the default instead of appending to it"] {
    (Project) { launch { args = List("-launch") } }.launch.args == List("-launch")
    (Project) { launch { args = List() } }.launch.args.isEmpty
  }
  ["map folder must end in .w3x"] {
    t.catch(() -> (Project) { map { folder = "hero" } }.map.folder).contains("endsWith")
  }
  ["entry must be a .yue file under src/"] {
    t.catch(() -> (Project) { map { entry = "main.yue" } }.map.entry).contains("startsWith")
    t.catch(() -> (Project) { map { entry = "src/main.lua" } }.map.entry).contains("endsWith")
  }
  ["build folder accepts relative output folders"] {
    (Project) { build { folder = "dist/bin" } }.build.folder == "dist/bin"
    (Project) { build { folder = "out" } }.build.folder == "out"
    (Project) { build { folder = #"build\maps"# } }.build.folder == #"build\maps"#
  }
  ["build folder must be relative without .."] {
    for (path in List("../x", #"out\..\.."#, "C:/x", #"D:\x"#, "/x", #"\x"#, "", ".")) {
      t.catch(() -> (Project) { build { folder = path } }.build.folder).contains("isRelativeFolder")
    }
  }
  ["build folder cannot be or be under maps, src or dist/stage"] {
    for (path in List("maps", "maps/x", "./maps", "Maps", "src", #"src\x"#, "dist/stage", #"dist\stage\x"#)) {
      t.catch(() -> (Project) { build { folder = path } }.build.folder).contains("isReservedFolder")
    }
  }
  ["map folder must be relative without .."] {
    t.catch(() -> (Project) { map { folder = "../x.w3x" } }.map.folder).contains("isRelativeFolder")
    t.catch(() -> (Project) { map { folder = "C:/x.w3x" } }.map.folder).contains("isRelativeFolder")
  }
  ["yue version must be semver"] {
    t.catch(() -> (Project) { yue { version = "latest" } }.yue.version).contains("matches")
  }
  ["assets accept paths and excludes"] {
    (Project) { assets { paths { ["icons/a.blp"] = #"ReplaceableTextures\CommandButtons\BTNA.blp"# } } }
      .assets.paths["icons/a.blp"] == #"ReplaceableTextures\CommandButtons\BTNA.blp"#
    (Project) { assets { exclude = List("credits/") } }.assets.exclude == List("credits/")
  }
  ["asset paths and excludes cannot be empty"] {
    t.catch(() -> (Project) { assets { paths { [""] = "x.blp" } } }.assets.paths.toMap()).contains("isEmpty")
    t.catch(() -> (Project) { assets { paths { ["a.blp"] = "" } } }.assets.paths.toMap()).contains("isEmpty")
    t.catch(() -> (Project) { assets { exclude = List("") } }.assets.exclude).contains("isEmpty")
  }
  ["settings inherit and colors replace"] {
    Project.settings.info.name == null
    Project.settings.players.isEmpty
    Project.settings.environment.fog.enabled == null
    (Project) { settings { environment { waterColor = List(1, 2, 3, 4) } } }
      .settings.environment.waterColor == List(1, 2, 3, 4)
    ((Project) { settings { environment { waterColor = List(1, 2, 3, 4) } } }) {
      settings { environment { waterColor = List(5, 6, 7, 8) } }
    }.settings.environment.waterColor == List(5, 6, 7, 8)
  }
  ["settings reject invalid mapping values"] {
    t.catch(() -> (Project) { settings { players { ["24"] {} } } }.settings.players.toMap()).contains("matches")
    t.catch(() -> (Project) { settings { gameplayConstants { ["Misc"] { ["X"] = "a\nb" } } } }
      .settings.gameplayConstants["Misc"].toMap()).contains("contains")
  }
  ["settings numeric bounds and colors"] {
    (Project) { settings { loadingScreen { background = -1 }; gameplay { heroMaxLevel = 1; foodLimit = 0 } } }
      .settings.loadingScreen.background == -1
    t.catch(() -> (Project) { settings { loadingScreen { background = -2 } } }.settings.loadingScreen.background)
      .contains("isBetween")
    t.catch(() -> (Project) { settings { gameplay { heroMaxLevel = 0 } } }.settings.gameplay.heroMaxLevel)
      .contains("isBetween")
    t.catch(() -> (Project) { settings { gameplay { foodLimit = 301 } } }.settings.gameplay.foodLimit)
      .contains("isBetween")
    t.catch(() -> (Project) { settings { environment { waterColor = List(0, 0, 0) } } }.settings.environment.waterColor)
      .contains("length")
    t.catch(() -> (Project) { settings { environment { waterColor = List(0, 0, 0, 256) } } }
      .settings.environment.waterColor).contains("isBetween")
  }
  ["settings names and nullable fields"] {
    (Project) { settings { info { name = "" }; players { ["0"] { controller = "user"; race = "nightelf" } } } }
      .settings.info.name == ""
    Project.settings.loadingScreen.model == null
    Project.settings.gameplay.foodLimit == null
    Project.settings.environment.waterColor == null
    t.catch(() -> (Project) { settings { players { ["0"] { controller = "elf" } } } }
      .settings.players["0"].controller).contains("Expected")
    t.catch(() -> (Project) { settings { players { ["0"] { race = "elf" } } } }
      .settings.players["0"].race).contains("Expected")
  }
  ["settings accept all player and force choices"] {
    for (choice in List("user", "computer", "neutral", "rescuable")) {
      (Project) { settings { players { ["0"] { controller = choice } } } }.settings.players["0"].controller == choice
    }
    for (choice in List("selectable", "human", "orc", "undead", "nightelf")) {
      (Project) { settings { players { ["0"] { race = choice } } } }.settings.players["0"].race == choice
    }
    (Project) { settings { forces { ["23"] { allied = false; alliedVictory = true; sharedVision = false
      sharedControl = true; sharedAdvancedControl = false } } } }.settings.forces["23"].sharedAdvancedControl == false
    t.catch(() -> (Project) { settings { forces { ["0"] { allied = 1 } } } }.settings.forces["0"].allied)
      .contains("Boolean")
  }
  ["settings enforce remaining numeric endpoints"] {
    (Project) { settings { loadingScreen { background = 2147483647 } } }.settings.loadingScreen.background == 2147483647
    t.catch(() -> (Project) { settings { loadingScreen { background = 2147483648 } } }.settings.loadingScreen.background)
      .contains("isBetween")
    (Project) { settings { gameplay { heroMaxLevel = 10000; foodLimit = 300 } } }.settings.gameplay.foodLimit == 300
    t.catch(() -> (Project) { settings { gameplay { heroMaxLevel = 10001 } } }.settings.gameplay.heroMaxLevel)
      .contains("isBetween")
    (Project) { settings { players { ["0"] { x = -10000000.0; y = 10000000.0 } } } }.settings.players["0"].x == -10000000.0
    t.catch(() -> (Project) { settings { players { ["0"] { y = 10000000.1 } } } }.settings.players["0"].y)
      .contains("isBetween")
    (Project) { settings { environment { fog { style = 2; density = 1.0 } } } }.settings.environment.fog.style == 2
    t.catch(() -> (Project) { settings { environment { fog { style = 3 } } } }.settings.environment.fog.style)
      .contains("isBetween")
    t.catch(() -> (Project) { settings { environment { fog { density = 1.1 } } } }.settings.environment.fog.density)
      .contains("isBetween")
    t.catch(() -> (Project) { settings { environment { fog { color = List(0, 0, 0, 1.5) } } } }
      .settings.environment.fog.color).contains("Int")
  }
  ["settings coordinates and fog distances accept whole numbers"] {
    (Project) { settings { players { ["0"] { x = 256; y = -896 } } } }.settings.players["0"].x == 256
    (Project) { settings { players { ["0"] { x = 256; y = -896 } } } }.settings.players["0"].y == -896
    (Project) { settings { environment { fog { start = 100; end = 1000; density = 1 } } } }
      .settings.environment.fog.end == 1000
    (Project) { settings { environment { fog { density = 0 } } } }.settings.environment.fog.density == 0
    t.catch(() -> (Project) { settings { players { ["0"] { x = 10000001 } } } }.settings.players["0"].x)
      .contains("isBetween")
    t.catch(() -> (Project) { settings { environment { fog { density = 2 } } } }.settings.environment.fog.density)
      .contains("isBetween")
    t.catch(() -> (Project) { settings { players { ["0"] { x = "1" } } } }.settings.players["0"].x)
      .contains("Expected")
  }
  ["an amending project renders as JSON"] {
    parsed.map.folder == "hero.w3x"
    parsed.map.entry == "src/main.yue"
    parsed.build.folder == "dist/bin"
    parsed.build.minify == false
    parsed.launch.args is Listing
    parsed.launch.args.toList() == List("-launch", "-windowmode", "windowed")
    !parsed.launch.hasProperty("gameExecutable")
    parsed.yue.version == "0.34.2"
    !parsed.yue.hasProperty("path")
    parsed.assets.paths is Dynamic
    parsed.assets.exclude.toList() == List()
  }
}
