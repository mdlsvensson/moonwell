amends "pkl:test"

import "pkl:json"
import "pkl:test" as t
import "../Project.pkl"
import "fixtures/project.pkl" as fixture

/// The fixture rendered through its module output, as `pkl eval -f json` does.
local fixtureJson = (fixture.output) { renderer = new JsonRenderer {} }.text
local parsed = new json.Parser {}.parse(fixtureJson) as Dynamic

facts {
  ["defaults"] {
    Project.map.folder == "map.w3x"
    Project.map.entry == "src/main.yue"
    Project.build.folder == "dist/bin"
    Project.build.minify == false
    Project.launch.gameExecutable == null
    Project.launch.args == List("-launch", "-windowmode", "windowed")
    Project.yue.version == "0.34.2"
    Project.yue.path == null
    Project.assets.paths.isEmpty
    Project.assets.exclude == List()
  }
  ["overrides are accepted"] {
    (Project) { map { folder = "hero.w3x"; entry = "src/game/init.yue" } }.map.entry == "src/game/init.yue"
  }
  ["launch args replace the default instead of appending to it"] {
    (Project) { launch { args = List("-launch") } }.launch.args == List("-launch")
    (Project) { launch { args = List() } }.launch.args.isEmpty
  }
  ["map folder must end in .w3x"] {
    t.catch(() -> (Project) { map { folder = "hero" } }.map.folder).contains("endsWith")
  }
  ["entry must be a .yue file under src/"] {
    t.catch(() -> (Project) { map { entry = "main.yue" } }.map.entry).contains("startsWith")
    t.catch(() -> (Project) { map { entry = "src/main.lua" } }.map.entry).contains("endsWith")
  }
  ["build folder accepts relative output folders"] {
    (Project) { build { folder = "dist/bin" } }.build.folder == "dist/bin"
    (Project) { build { folder = "out" } }.build.folder == "out"
    (Project) { build { folder = #"build\maps"# } }.build.folder == #"build\maps"#
  }
  ["build folder must be relative without .."] {
    for (path in List("../x", #"out\..\.."#, "C:/x", #"D:\x"#, "/x", #"\x"#, "", ".")) {
      t.catch(() -> (Project) { build { folder = path } }.build.folder).contains("isRelativeFolder")
    }
  }
  ["build folder cannot be or be under maps, src or dist/stage"] {
    for (path in List("maps", "maps/x", "./maps", "Maps", "src", #"src\x"#, "dist/stage", #"dist\stage\x"#)) {
      t.catch(() -> (Project) { build { folder = path } }.build.folder).contains("isReservedFolder")
    }
  }
  ["map folder must be relative without .."] {
    t.catch(() -> (Project) { map { folder = "../x.w3x" } }.map.folder).contains("isRelativeFolder")
    t.catch(() -> (Project) { map { folder = "C:/x.w3x" } }.map.folder).contains("isRelativeFolder")
  }
  ["yue version must be semver"] {
    t.catch(() -> (Project) { yue { version = "latest" } }.yue.version).contains("matches")
  }
  ["assets accept paths and excludes"] {
    (Project) { assets { paths { ["icons/a.blp"] = #"ReplaceableTextures\CommandButtons\BTNA.blp"# } } }
      .assets.paths["icons/a.blp"] == #"ReplaceableTextures\CommandButtons\BTNA.blp"#
    (Project) { assets { exclude = List("credits/") } }.assets.exclude == List("credits/")
  }
  ["asset paths and excludes cannot be empty"] {
    t.catch(() -> (Project) { assets { paths { [""] = "x.blp" } } }.assets.paths.toMap()).contains("isEmpty")
    t.catch(() -> (Project) { assets { paths { ["a.blp"] = "" } } }.assets.paths.toMap()).contains("isEmpty")
    t.catch(() -> (Project) { assets { exclude = List("") } }.assets.exclude).contains("isEmpty")
  }
  ["an amending project renders as JSON"] {
    parsed.map.folder == "hero.w3x"
    parsed.map.entry == "src/main.yue"
    parsed.build.folder == "dist/bin"
    parsed.build.minify == false
    parsed.launch.args is Listing
    parsed.launch.args.toList() == List("-launch", "-windowmode", "windowed")
    !parsed.launch.hasProperty("gameExecutable")
    parsed.yue.version == "0.34.2"
    !parsed.yue.hasProperty("path")
    parsed.assets.paths is Dynamic
    parsed.assets.exclude.toList() == List()
  }
}
