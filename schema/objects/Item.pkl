/// A custom item.
///
/// Omitted or `null` properties inherit from `base`. See `Object.pkl` for `base` and `properties`.
module moonwell.objects.Item

extends "../generated/ItemProps.pkl"

/// The object's own id: four ASCII letters or digits, such as `"I000"`.
/// Gameplay code reads it from `src/generated/objects.yue`.
id: String(matches(Regex(#"[A-Za-z0-9]{4}"#)))
