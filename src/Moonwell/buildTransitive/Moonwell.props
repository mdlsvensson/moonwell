<Project>

  <!--
    Added to every project that references the Moonwell package.
    build/ holds what the Moonwell build writes (the map's Main, the staged map); dotnet build must not compile it.
    Moonwell.dll and Moonwell.Natives.dll must sit next to the map's assembly: the build reads the Lua they carry.
  -->
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build/**" />
  </ItemGroup>

</Project>
