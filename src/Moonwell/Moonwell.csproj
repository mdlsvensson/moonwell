<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The Moonwell runtime for Warcraft III maps in C#: units, components, reactions, buffs and timers, with its C# source for the Lua build and the multiplayer analyzer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moonwell.Natives\Moonwell.Natives.csproj" />
  </ItemGroup>

  <!--
    The multiplayer analyzer runs in every project that references the package: pack builds it and puts it under
    analyzers/dotnet/cs. It is not a ProjectReference, because CSharp.lua would compile a referenced project's source.
    A project that references Moonwell.csproj itself adds the analyzer as an Analyzer reference.
  -->
  <ItemGroup>
    <None Include="..\Moonwell.Analyzers\bin\$(Configuration)\netstandard2.0\Moonwell.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <Target Name="BuildAnalyzer" BeforeTargets="GenerateNuspec">
    <MSBuild Projects="..\Moonwell.Analyzers\Moonwell.Analyzers.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <!--
    Moonwell.Package.Version is the package's version, which a map can print. Each build writes it to obj/ from $(Version),
    compiles it, and packs it beside the other sources, so the map's Lua carries the version of the package it uses.
    The class is not named Version, which a map with using System would find twice.
  -->
  <PropertyGroup>
    <PackageSourceText>
namespace Moonwell
{
    /// &lt;summary&gt;The Moonwell package the map is built with.&lt;/summary&gt;
    public static class Package
    {
        /// &lt;summary&gt;Moonwell's version, as the package gives it, such as "0.2.4".&lt;/summary&gt;
        public const string Version = "$(Version)"%3B
    }
}
</PackageSourceText>
  </PropertyGroup>

  <Target Name="WritePackageSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PackageSource>$(IntermediateOutputPath)Package.g.cs</PackageSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackageSource)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="$(PackageSourceText.Trim())" />
    <ItemGroup>
      <Compile Include="$(PackageSource)" />
      <Content Include="$(PackageSource)" Pack="true" PackagePath="contentFiles/cs/net10.0/Moonwell/Core/Package.g.cs" BuildAction="None" />
      <FileWrites Include="$(PackageSource)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="moonwell.lua" LogicalName="Moonwell.moonwell.lua" />
  </ItemGroup>

  <!--
    The package carries its C# source beside its library: dotnet build uses the library, CSharp.lua compiles the source
    (from ~/.nuget/packages/moonwell/<version>/contentFiles/cs). obj/ and bin/ are left out: MSBuild generates files there.
  -->
  <ItemGroup>
    <Content Include="**/*.cs" Exclude="obj/**;bin/**" Pack="true" PackagePath="contentFiles/cs/net10.0/Moonwell/" BuildAction="None" />
    <Content Include="buildTransitive/Moonwell.props" Pack="true" PackagePath="buildTransitive/Moonwell.props" />
    <Content Include="buildTransitive/Moonwell.targets" Pack="true" PackagePath="buildTransitive/Moonwell.targets" />
  </ItemGroup>

</Project>
