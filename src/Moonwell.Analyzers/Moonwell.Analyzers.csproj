<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The multiplayer analyzer (decision 13) and the Lua rules (C# CSharp.lua cannot compile). The compiler loads it into dotnet build, so it targets netstandard2.0.
    The Moonwell package carries it under analyzers/dotnet/cs; see Moonwell.csproj.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The rules ship with Moonwell's version, so no release-tracking files. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
