<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Build.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moonwell.War3Net.Build" Version="6.1.2-moonwell.1" />
    <!-- Moonwell.War3Net.Build brings War3Net.CSharpLua (through War3Net.CodeAnalysis.Transpilers); the fork's package has the same CSharp.lua assembly, so it takes the place. -->
    <PackageReference Include="War3Net.CSharpLua" Version="2.0.4" ExcludeAssets="all" />
    <PackageReference Include="Moonwell.CSharpLua" Version="2.0.4-moonwell.9" />
    <PackageReference Include="Moonwell.CSharpLua.CoreSystem" Version="2.0.3-moonwell.2" />
  </ItemGroup>

</Project>
