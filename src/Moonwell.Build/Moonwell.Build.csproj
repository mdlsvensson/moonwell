<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Build.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The deck shapes of the game's walkable destructables, measured on 3.0.1 by wc3-cs docs/tools/deck-probe; read by the physics package's bridges. -->
    <EmbeddedResource Include="Data/Decks.txt" LogicalName="Moonwell.Build.Data.Decks.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moonwell.War3Net.Build" Version="6.1.2-moonwell.4" />
    <!-- Moonwell.War3Net.Build brings War3Net.CSharpLua (through War3Net.CodeAnalysis.Transpilers); the fork's package has the same CSharp.lua assembly, so it takes the place. -->
    <PackageReference Include="War3Net.CSharpLua" Version="2.0.4" ExcludeAssets="all" />
    <PackageReference Include="Moonwell.CSharpLua" Version="2.0.4-moonwell.13" />
    <PackageReference Include="Moonwell.CSharpLua.CoreSystem" Version="2.0.3-moonwell.5" />
  </ItemGroup>

</Project>
