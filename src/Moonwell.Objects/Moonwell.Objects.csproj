<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Warcraft III's standard units, abilities, items, buffs and other objects as C# classes to inherit, for Moonwell.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets none, so that a map that references only Moonwell.Objects still gets Moonwell's analyzer. -->
    <ProjectReference Include="..\Moonwell\Moonwell.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Generated/Values/*.json" LogicalName="Moonwell.Objects.Values.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The package carries its C# source beside its library, like Moonwell (see Moonwell.csproj): the generated classes are source
    too, and the values the build reads are embedded in the library. It depends on Moonwell through the project reference.
  -->
  <ItemGroup>
    <Content Include="**/*.cs" Exclude="obj/**;bin/**" Pack="true" PackagePath="contentFiles/cs/net10.0/Moonwell.Objects/" BuildAction="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Objects.Tests" />
  </ItemGroup>

</Project>
