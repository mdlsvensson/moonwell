<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Each player's mouse and camera for Moonwell maps.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets none, so that a map that references only Moonwell.Input still gets Moonwell's analyzer. -->
    <ProjectReference Include="..\Moonwell\Moonwell.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Moonwell.Maths\Moonwell.Maths.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!--
    The package carries its C# source beside its library, like Moonwell (see Moonwell.csproj). A map without it
    carries none of its code: CSharp.lua compiles only the packages a map references.
  -->
  <ItemGroup>
    <Content Include="**/*.cs" Exclude="obj/**;bin/**" Pack="true" PackagePath="contentFiles/cs/net10.0/Moonwell.Input/" BuildAction="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Testing" />
    <InternalsVisibleTo Include="Moonwell.Tests" />
    <!-- Its test of the build's camera numbers reading in, which reads the setup each name made. -->
    <InternalsVisibleTo Include="Moonwell.Build.Tests" />
  </ItemGroup>

</Project>
