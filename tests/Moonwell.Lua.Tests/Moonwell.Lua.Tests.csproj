<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- CSharpLua and NLua are not annotated for nullable reference types; the spike's build disables it too. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NLua" Version="1.7.9" />
    <PackageReference Include="Moonwell.War3Net.Build" Version="6.1.2-moonwell.3" />
    <!-- As in Moonwell.Build: the fork's CSharp.lua (through Moonwell.Build) takes the place of the one War3Net.Build brings. -->
    <PackageReference Include="War3Net.CSharpLua" Version="2.0.4" ExcludeAssets="all" />
    <PackageReference Include="Moonwell.CSharpLua.CoreSystem" Version="2.0.3-moonwell.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Moonwell.Build\Moonwell.Build.csproj" />
    <ProjectReference Include="..\Moonwell.Testing\Moonwell.Testing.csproj" />
  </ItemGroup>

</Project>
